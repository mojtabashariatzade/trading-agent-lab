# PLACEHOLDERS ONLY. Enter real values in the hosting provider's secret UI.
# Do not send keys in chat or put them in Cursor agent environment variables.
# Monitoring uses RUNTIME_STATUS_PATH / RUNTIME_CONFIG_PATH — never secrets.
GITHUB_REPOSITORY=YOUR_OWNER/trading-agent-lab
GITHUB_TOKEN=
CURSOR_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CONTROL_CHAT_ID=
TELEGRAM_OWNER_IDS=
TELEGRAM_REPORT_CHAT_ID=
TELEGRAM_OPTIONAL=false
AGENT_RUNTIME=cloud
ALLOW_AGENT_RUNS=false
SPEND_LIMIT_CONFIRMED=false
REPOSITORY_PROTECTION_CONFIRMED=false
ALLOW_PUBLIC_REPO=false
AUTO_MERGE_SAFE=true
AUTONOMOUS_DEFAULT=true
MAX_DAILY_LAUNCHES=12
MAX_ATTEMPTS=2
MAX_RUN_SECONDS=5400
POLL_SECONDS=30
HEARTBEAT_SECONDS=300
STUCK_TIMEOUT_SECONDS=300
MAX_STUCK_RETRIES=3
STUCK_BACKOFF_SECONDS=15
SUPERVISOR_RESTART_ENABLED=false
RUNTIME_STATUS_PATH=
RUNTIME_CONFIG_PATH=
CURSOR_MODEL=
